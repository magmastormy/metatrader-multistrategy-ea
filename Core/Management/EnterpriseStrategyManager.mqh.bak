//+------------------------------------------------------------------+
//| Update AI Performance Metrics for AI Strategies (L6-016)        |
//+------------------------------------------------------------------+
void CEnterpriseStrategyManager::UpdateAIPerformanceMetrics(const string strategyName, const SAIModelMetrics &metrics)
{
    int idx = FindStrategyIndexByName(strategyName);
    if(idx < 0 || idx >= m_strategyCount)
        return;
    
    // Only apply to AI strategies
    ENUM_STRATEGY_TYPE stratType = m_strategies[idx].strategy.GetType();
    bool isAI = (stratType == STRATEGY_BRAIN || stratType == STRATEGY_AI_ENHANCED);
    if(!isAI)
        return;
    
    // Store AI metrics in the strategy entry for use in weight adaptation
    // Reuse recentWinRate for AI accuracy, avgProfit for AI profitability
    m_strategies[idx].recentWinRate = metrics.recentAccuracy;
    m_strategies[idx].avgProfit = metrics.profitability;
    
    // Adjust health score based on AI accuracy
    double aiHealth = metrics.accuracy;
    if(aiHealth > 0.0)
    {
        // Blend AI accuracy with existing health score (70% existing, 30% AI)
        m_strategies[idx].healthScore = 0.70 * m_strategies[idx].healthScore + 0.30 * aiHealth;
        m_strategies[idx].healthScore = MathMax(0.0, MathMin(1.0, m_strategies[idx].healthScore));
    }
    
    // Log the update
    PrintFormat("[AI-FEEDBACK] %s | %s | accuracy=%.3f | profitability=%.3f | recentAcc=%.3f | health=%.3f",
                m_symbol, strategyName, metrics.accuracy, metrics.profitability, metrics.recentAccuracy, m_strategies[idx].healthScore);
}

//+------------------------------------------------------------------+
//| Calculate Effective Quorum Parameters (Internal)                |
//+------------------------------------------------------------------+
void CEnterpriseStrategyManager::CalculateEffectiveQuorumParamsInternal(
    const string symbol,
    const int activeLiveStrategies,
    const int buyVotes,
    const int sellVotes,
    const int eligibleLiveVoterCount,
    const double buyDirectionalQuality,
    const double sellDirectionalQuality,
    const double buyScore,
    const double sellScore,
    const bool readyWeightMet,
    const ENUM_SIGNAL_EVAL_MODE evalMode,
    CUnifiedSignalPipeline* pipeline,
    StrategyEntry &strategies[],
    int &buyContributorIndices[],
    int &sellContributorIndices[],
    double &effectiveQualityThreshold,
    double &supportFloor,
    int &effectiveMinVoters,
    double &buyQuorum,
    double &sellQuorum
) const
{
    // Base quorum thresholds from configuration
    int baseMinQuorum = (evalMode == EVAL_MODE_INTRABAR) ? m_intrabarMinQuorum : m_minQuorum;
    double baseQuorumThreshold = m_quorumThreshold;
    
    // Effective minimum voters - ensure at least baseMinQuorum
    effectiveMinVoters = MathMax(baseMinQuorum, eligibleLiveVoterCount);
    
    // Support floor based on evaluation mode
    supportFloor = (evalMode == EVAL_MODE_INTRABAR) ? m_supportFloorIntrabar : m_supportFloorNewBar;
    
    // Quality threshold based on pipeline confidence floor and regime
    double pipelineConfFloor = 0.0;
    if(pipeline != NULL)
    {
        pipelineConfFloor = pipeline.GetLastEffectiveMinConfidence();
    }
    effectiveQualityThreshold = MathMax(m_pipelineMinConfidence, pipelineConfFloor);
    
    // Adjust quorum thresholds based on directional quality and voter count
    // Higher directional quality allows slightly lower quorum
    double qualityAdjustmentBuy = (buyDirectionalQuality > 0.7) ? -0.05 : 0.0;
    double qualityAdjustmentSell = (sellDirectionalQuality > 0.7) ? -0.05 : 0.0;
    
    // Sparse intrabar adjustment
    if(evalMode == EVAL_MODE_INTRABAR && m_intrabarDynamicQuorumEnabled)
    {
        if(eligibleLiveVoterCount < 3)
        {
            // For very sparse voting, require higher quality
            qualityAdjustmentBuy += 0.10;
            qualityAdjustmentSell += 0.10;
        }
    }
    
    buyQuorum = MathMax(0.35, MathMin(0.85, baseQuorumThreshold + qualityAdjustmentBuy));
    sellQuorum = MathMax(0.35, MathMin(0.85, baseQuorumThreshold + qualityAdjustmentSell));
    
    // Log quorum parameters for diagnostics
    PrintFormat("[CONSENSUS-QUORUM] %s | mode=%s | minVoters=%d | supportFloor=%.2f | qualityThresh=%.2f | buyQuorum=%.2f | sellQuorum=%.2f",
                symbol,
                (evalMode == EVAL_MODE_INTRABAR ? "INTRABAR" : "NEW_BAR"),
                effectiveMinVoters, supportFloor, effectiveQualityThreshold, buyQuorum, sellQuorum);
}

//+------------------------------------------------------------------+
//| Evaluate Consensus Internal (Main Consensus Logic)              |
//+------------------------------------------------------------------+
ENUM_TRADE_SIGNAL CEnterpriseStrategyManager::EvaluateConsensusInternal(const string symbol, double &confidence, int &confluence,
                                                                         ENUM_SIGNAL_EVAL_MODE evalMode)
{
    ulong startTime = GetMicrosecondCount();
    
    // Reset outputs
    confidence = 0.0;
    confluence = 0;
    
    // Check if we have live voting strategies
    int activeLiveStrategies = 0;
    for(int i = 0; i < m_strategyCount; i++)
    {
        if(IsStrategyLiveVoter(i))
        {
            activeLiveStrategies++;
        }
    }
    
    if(activeLiveStrategies == 0)
    {
        PrintFormat("[CONSENSUS-ABSTAIN] %s | No live voting strategies", symbol);
        return TRADE_SIGNAL_NONE;
    }
    
    // Collect votes from each strategy
    int buyVotes = 0;
    int sellVotes = 0;
    int eligibleLiveVoterCount = 0;
    double buyScore = 0.0;
    double sellScore = 0.0;
    double buyDirectionalQuality = 0.0;
    double sellDirectionalQuality = 0.0;
    
    int buyContributorIndices[];
    int sellContributorIndices[];
    ArrayResize(buyContributorIndices, 0);
    ArrayResize(sellContributorIndices, 0);
    
    for(int i = 0; i < m_strategyCount; i++)
    {
        if(!IsStrategyLiveVoter(i))
            continue;
        
        eligibleLiveVoterCount++;

        // Get signal from strategy (direct array access - MQL5 doesn't support local references to array elements)
        double stratConf = 0.0;
        ENUM_TRADE_SIGNAL signal = m_strategies[i].strategy.GetSignal(stratConf);
        
        if(signal == TRADE_SIGNAL_NONE)
        {
            // Strategy abstains
            continue;
        }
        
        // Apply pipeline filtering if available
        bool passedPipeline = true;
        if(m_pipeline != NULL)
        {
            double filteredConf = stratConf;
            ENUM_TRADE_SIGNAL filteredSignal = m_pipeline.ProcessSignal(m_strategies[i].strategy, symbol, m_strategies[i].timeframe, filteredConf);
            
            if(filteredSignal == TRADE_SIGNAL_NONE)
            {
                passedPipeline = false;
                // Log filtered signal
                PrintFormat("[CONSENSUS-FILTERED] %s | %s | raw=%s conf=%.2f | filtered by %s",
                            symbol, m_strategies[i].name, EnumToString(signal), stratConf,
                            m_pipeline.GetLastFilterName());
            }
            else
            {
                signal = filteredSignal;
                stratConf = filteredConf;
            }
        }
        
        if(!passedPipeline)
            continue;
        
        // Calculate participation multiplier from health monitor
        double participation = GetStrategyParticipationMultiplier(i);
        double reliability = GetStrategyReliabilityMultiplier(i);
        
        // Weighted score = confidence * weight * participation * reliability
        double weight = m_strategies[i].weight;
        double score = stratConf * weight * participation * reliability;
        
        // Track directional quality
        if(signal == TRADE_SIGNAL_BUY)
        {
            buyVotes++;
            buyScore += score;
            buyDirectionalQuality += stratConf * weight;
            int idx = ArraySize(buyContributorIndices);
            ArrayResize(buyContributorIndices, idx + 1);
            buyContributorIndices[idx] = i;
        }
        else if(signal == TRADE_SIGNAL_SELL)
        {
            sellVotes++;
            sellScore += score;
            sellDirectionalQuality += stratConf * weight;
            int idx = ArraySize(sellContributorIndices);
            ArrayResize(sellContributorIndices, idx + 1);
            sellContributorIndices[idx] = i;
        }
    }
    
    // Normalize directional quality
    if(buyVotes > 0) buyDirectionalQuality /= buyVotes;
    if(sellVotes > 0) sellDirectionalQuality /= sellVotes;
    
    // Check if any votes exist
    if(buyVotes == 0 && sellVotes == 0)
    {
        PrintFormat("[CONSENSUS-ABSTAIN] %s | All strategies abstained or filtered out", symbol);
        return TRADE_SIGNAL_NONE;
    }
    
    // Check ready weight ratio (minimum combined weight of voting strategies)
    double totalVotingWeight = 0.0;
    for(int i = 0; i < m_strategyCount; i++)
    {
        if(IsStrategyLiveVoter(i))
        {
            totalVotingWeight += m_strategies[i].weight;
        }
    }
    
    double readyWeightRatio = (totalVotingWeight > 0) ? (buyScore + sellScore) / totalVotingWeight : 0.0;
    bool readyWeightMet = (readyWeightRatio >= m_minReadyWeightRatio);
    
    if(!readyWeightMet)
    {
        PrintFormat("[CONSENSUS-REJECT] %s | Ready weight ratio %.2f < min %.2f",
                    symbol, readyWeightRatio, m_minReadyWeightRatio);
        return TRADE_SIGNAL_NONE;
    }
    
    // Calculate effective quorum parameters
    double effectiveQualityThreshold = 0.0;
    double supportFloor = 0.0;
    int effectiveMinVoters = 0;
    double buyQuorum = 0.0;
    double sellQuorum = 0.0;
    
    CalculateEffectiveQuorumParamsInternal(symbol, activeLiveStrategies, buyVotes, sellVotes,
                                           eligibleLiveVoterCount, buyDirectionalQuality, sellDirectionalQuality,
                                           buyScore, sellScore, readyWeightMet, evalMode,
                                           m_pipeline, m_strategies, buyContributorIndices, sellContributorIndices,
                                           effectiveQualityThreshold, supportFloor, effectiveMinVoters, buyQuorum, sellQuorum);
    
    // Determine winning side
    ENUM_TRADE_SIGNAL consensusSignal = TRADE_SIGNAL_NONE;
    double winningScore = 0.0;
    double losingScore = 0.0;
    int winningVotes = 0;
    int losingVotes = 0;
    
    if(buyScore > sellScore)
    {
        consensusSignal = TRADE_SIGNAL_BUY;
        winningScore = buyScore;
        losingScore = sellScore;
        winningVotes = buyVotes;
        losingVotes = sellVotes;
    }
    else if(sellScore > buyScore)
    {
        consensusSignal = TRADE_SIGNAL_SELL;
        winningScore = sellScore;
        losingScore = buyScore;
        winningVotes = sellVotes;
        losingVotes = buyVotes;
    }
    else
    {
        // Tie - no consensus
        PrintFormat("[CONSENSUS-TIE] %s | buyScore=%.3f sellScore=%.3f", symbol, buyScore, sellScore);
        return TRADE_SIGNAL_NONE;
    }
    
    // Check minimum voters
    if(winningVotes < effectiveMinVoters)
    {
        PrintFormat("[CONSENSUS-REJECT] %s | Winning votes %d < minVoters %d",
                    symbol, winningVotes, effectiveMinVoters);
        return TRADE_SIGNAL_NONE;
    }
    
    // Check support floor (minimum winning score relative to total)
    double totalScore = winningScore + losingScore;
    double supportRatio = (totalScore > 0) ? winningScore / totalScore : 0.0;
    
    if(supportRatio < supportFloor)
    {
        PrintFormat("[CONSENSUS-REJECT] %s | Support ratio %.2f < floor %.2f",
                    symbol, supportRatio, supportFloor);
        return TRADE_SIGNAL_NONE;
    }
    
    // Check quorum threshold
    double winningQuorum = (consensusSignal == TRADE_SIGNAL_BUY) ? buyQuorum : sellQuorum;
    double quorumRatio = (eligibleLiveVoterCount > 0) ? (double)winningVotes / eligibleLiveVoterCount : 0.0;
    
    if(quorumRatio < winningQuorum)
    {
        PrintFormat("[CONSENSUS-REJECT] %s | Quorum ratio %.2f < threshold %.2f",
                    symbol, quorumRatio, winningQuorum);
        return TRADE_SIGNAL_NONE;
    }
    
    // Check conflict deadband
    if(losingVotes > 0)
    {
        double conflictRatio = (double)losingVotes / eligibleLiveVoterCount;
        if(conflictRatio > m_conflictDeadband)
        {
            PrintFormat("[CONSENSUS-VETOED] %s | Conflict ratio %.2f > deadband %.2f",
                        symbol, conflictRatio, m_conflictDeadband);
            return TRADE_SIGNAL_NONE;
        }
    }
    
    // Check quality threshold
    double winningQuality = (consensusSignal == TRADE_SIGNAL_BUY) ? buyDirectionalQuality : sellDirectionalQuality;
    if(winningQuality < effectiveQualityThreshold)
    {
        PrintFormat("[CONSENSUS-REJECT] %s | Quality %.2f < threshold %.2f",
                    symbol, winningQuality, effectiveQualityThreshold);
        return TRADE_SIGNAL_NONE;
    }
    
    // Consensus reached!
    confluence = winningVotes;
    confidence = MathMin(0.95, winningQuality * 0.8 + supportRatio * 0.2);
    
    // Log consensus decision
    string decisionClass = "FULL_QUORUM";
    if(evalMode == EVAL_MODE_INTRABAR && eligibleLiveVoterCount < 3)
    {
        decisionClass = "SPARSE_INTRABAR";
    }
    
    PrintFormat("[CONSENSUS-DECISION] %s | %s | class=%s | conf=%.2f | confluence=%d | votes=%d/%d | support=%.2f | quorum=%.2f/%.2f",
                symbol, EnumToString(consensusSignal), decisionClass, confidence, confluence,
                buyVotes, sellVotes, supportRatio, quorumRatio, winningQuorum);
    
    // Performance timing log
    ulong elapsed = GetMicrosecondCount() - startTime;
    CJsonLogger::LogPerformance("EnterpriseStrategyManager", "EvaluateConsensusInternal_us", (double)elapsed, CCorrelationIdGenerator::Generate());
    
    return consensusSignal;
}

//+------------------------------------------------------------------+
//| Evaluate Consensus Two-Tier Internal (Probe + Full)             |
//+------------------------------------------------------------------+
ENUM_TRADE_SIGNAL CEnterpriseStrategyManager::EvaluateConsensusTwoTierInternal(const string symbol, double &confidence, int &confluence,
                                                                                  ENUM_SIGNAL_EVAL_MODE evalMode)
{
    // Phase 1: Probe-only evaluation with eligible probe strategies
    // This is a fast path to check if there's enough probe support
    
    ulong startTime = GetMicrosecondCount();
    
    int probeBuyVotes = 0;
    int probeSellVotes = 0;
    int probeEligibleCount = 0;
    
    for(int i = 0; i < m_strategyCount; i++)
    {
        if(!IsStrategyLiveVoter(i))
            continue;
        
        if(!m_strategies[i].isProbeEligible)
            continue;
        
        probeEligibleCount++;
        
        // Get raw signal without full pipeline filtering for probe
        double stratConf = 0.0;
        ENUM_TRADE_SIGNAL signal = m_strategies[i].strategy.GetSignal(stratConf);
        
        if(signal == TRADE_SIGNAL_BUY && stratConf >= 0.5)
            probeBuyVotes++;
        else if(signal == TRADE_SIGNAL_SELL && stratConf >= 0.5)
            probeSellVotes++;
    }
    
    // Quick probe check - if no probe support, don't proceed to full evaluation
    if(probeBuyVotes == 0 && probeSellVotes == 0)
    {
        PrintFormat("[CONSENSUS-PROBE] %s | No probe support (buy=%d sell=%d)", symbol, probeBuyVotes, probeSellVotes);
        confidence = 0.0;
        confluence = 0;
        return TRADE_SIGNAL_NONE;
    }
    
    // Phase 2: Full consensus evaluation
    ENUM_TRADE_SIGNAL result = EvaluateConsensusInternal(symbol, confidence, confluence, evalMode);
    
    ulong elapsed = GetMicrosecondCount() - startTime;
    CJsonLogger::LogPerformance("EnterpriseStrategyManager", "EvaluateConsensusTwoTierInternal_us", (double)elapsed, CCorrelationIdGenerator::Generate());
    
    return result;
}

//+------------------------------------------------------------------+
//| Evaluate Consensus Probe Only Internal (Fast Path)              |
//+------------------------------------------------------------------+
ENUM_TRADE_SIGNAL CEnterpriseStrategyManager::EvaluateConsensusProbeOnlyInternal(const string symbol, double &confidence, int &confluence,
                                                                                    ENUM_SIGNAL_EVAL_MODE evalMode)
{
    // Fast probe-only evaluation - no pipeline filtering, no full quorum
    // Used for intrabar probe voting to quickly check signal direction
    
    ulong startTime = GetMicrosecondCount();
    
    int probeBuyVotes = 0;
    int probeSellVotes = 0;
    double probeBuyScore = 0.0;
    double probeSellScore = 0.0;
    int probeEligibleCount = 0;
    
    for(int i = 0; i < m_strategyCount; i++)
    {
        if(!IsStrategyLiveVoter(i))
            continue;
        
        if(!m_strategies[i].isProbeEligible)
            continue;
        
        probeEligibleCount++;
        
        // Get raw signal
        double stratConf = 0.0;
        ENUM_TRADE_SIGNAL signal = m_strategies[i].strategy.GetSignal(stratConf);
        
        if(signal == TRADE_SIGNAL_NONE || stratConf < m_sparseIntrabarMinQuality)
            continue;
        
        double weight = m_strategies[i].weight;
        double participation = GetStrategyParticipationMultiplier(i);
        double reliability = GetStrategyReliabilityMultiplier(i);
        double score = stratConf * weight * participation * reliability;
        
        if(signal == TRADE_SIGNAL_BUY)
        {
            probeBuyVotes++;
            probeBuyScore += score;
        }
        else if(signal == TRADE_SIGNAL_SELL)
        {
            probeSellVotes++;
            probeSellScore += score;
        }
    }
    
    if(probeBuyVotes == 0 && probeSellVotes == 0)
    {
        confidence = 0.0;
        confluence = 0;
        return TRADE_SIGNAL_NONE;
    }
    
    // Determine winning side
    ENUM_TRADE_SIGNAL probeSignal = TRADE_SIGNAL_NONE;
    double winningScore = 0.0;
    int winningVotes = 0;
    
    if(probeBuyScore > probeSellScore)
    {
        probeSignal = TRADE_SIGNAL_BUY;
        winningScore = probeBuyScore;
        winningVotes = probeBuyVotes;
    }
    else if(probeSellScore > probeBuyScore)
    {
        probeSignal = TRADE_SIGNAL_SELL;
        winningScore = probeSellScore;
        winningVotes = probeSellVotes;
    }
    
    // Check minimum probe support ratio
    double supportRatio = (probeEligibleCount > 0) ? (double)winningVotes / probeEligibleCount : 0.0;
    if(supportRatio < m_sparseIntrabarMinSupportRatio)
    {
        PrintFormat("[CONSENSUS-PROBE-REJECT] %s | Support ratio %.2f < min %.2f",
                    symbol, supportRatio, m_sparseIntrabarMinSupportRatio);
        confidence = 0.0;
        confluence = 0;
        return TRADE_SIGNAL_NONE;
    }
    
    confluence = winningVotes;
    confidence = MathMin(0.8, winningScore / MathMax(1.0, probeBuyScore + probeSellScore));
    
    PrintFormat("[CONSENSUS-PROBE-DECISION] %s | %s | conf=%.2f | confluence=%d | support=%.2f",
                symbol, EnumToString(probeSignal), confidence, confluence, supportRatio);
    
    ulong elapsed = GetMicrosecondCount() - startTime;
    CJsonLogger::LogPerformance("EnterpriseStrategyManager", "EvaluateConsensusProbeOnlyInternal_us", (double)elapsed, CCorrelationIdGenerator::Generate());
    
    return probeSignal;
}

//+------------------------------------------------------------------+
//| Try Fallback Solo Signal Internal (When All Strategies Abstain) |
//+------------------------------------------------------------------+
ENUM_TRADE_SIGNAL CEnterpriseStrategyManager::TryFallbackSoloSignalInternal(const string symbol,
                                                                                ENUM_SIGNAL_EVAL_MODE evalMode,
                                                                                double &outConfidence,
                                                                                int &outConfluence,
                                                                                string &outReason)
{
    // This is called when all strategies abstain but pipeline is available
    // Try to find the single best strategy signal with relaxed thresholds
    
    ulong startTime = GetMicrosecondCount();
    
    ENUM_TRADE_SIGNAL bestSignal = TRADE_SIGNAL_NONE;
    double bestScore = -1.0;
    string bestStrategy = "";
    double bestConfidence = 0.0;
    
    for(int i = 0; i < m_strategyCount; i++)
    {
        if(!m_strategies[i].enabled || m_strategies[i].strategy == NULL)
            continue;
        
        // Skip AI strategies in indicator-only mode
        ENUM_STRATEGY_TYPE stratType = m_strategies[i].strategy.GetType();
        bool isAI = (stratType == STRATEGY_BRAIN || stratType == STRATEGY_AI_ENHANCED);
        
        if(isAI && m_strategyRegistry != NULL && m_strategyRegistry.GetMode() == EA_MODE_INDICATOR_ONLY)
            continue;
        
        // Get raw signal from strategy
        double stratConf = 0.0;
        ENUM_TRADE_SIGNAL signal = m_strategies[i].strategy.GetSignal(stratConf);
        
        if(signal == TRADE_SIGNAL_NONE)
            continue;
        
        // Apply pipeline filtering if available (but with relaxed threshold)
        bool passedPipeline = true;
        double filteredConf = stratConf;
        ENUM_TRADE_SIGNAL filteredSignal = signal;
        
        if(m_pipeline != NULL)
        {
            filteredSignal = m_pipeline.ProcessSignal(m_strategies[i].strategy, symbol, m_strategies[i].timeframe, filteredConf);
            if(filteredSignal == TRADE_SIGNAL_NONE)
            {
                // For solo fallback, we allow signals that were filtered
                // but track that they were filtered
                passedPipeline = false;
            }
            else
            {
                signal = filteredSignal;
                stratConf = filteredConf;
            }
        }
        
        // Apply basic quality filters
        double weight = m_strategies[i].weight;
        double participation = GetStrategyParticipationMultiplier(i);
        double reliability = GetStrategyReliabilityMultiplier(i);
        
        // Score = confidence * weight * participation * reliability
        double readinessScore = m_strategies[i].readinessScore;
        double contextScore = m_strategies[i].contextScore;
        double costScore = m_strategies[i].costScore;
        double qualityMultiplier = (readinessScore * 0.4 + contextScore * 0.4 + costScore * 0.2);
        double score = stratConf * weight * participation * reliability * qualityMultiplier;
        
        // Apply minimum threshold (relaxed for solo fallback)
        double minSoloConfidence = (evalMode == EVAL_MODE_INTRABAR) ? 0.70 : 0.65;
        if(stratConf < minSoloConfidence)
        {
            PrintFormat("[CONSENSUS-SOLO-SKIP] %s | %s conf=%.2f < min=%.2f",
                        symbol, m_strategies[i].name, stratConf, minSoloConfidence);
            continue;
        }
        
        // Boost score if signal passed pipeline
        if(passedPipeline)
        {
            score *= 1.1; // 10% boost for pipeline-validated signals
        }
        
        if(score > bestScore)
        {
            bestScore = score;
            bestSignal = signal;
            bestStrategy = m_strategies[i].name;
            bestConfidence = stratConf;
        }
    }
    
    if(bestSignal != TRADE_SIGNAL_NONE)
    {
        outConfidence = MathMin(0.85, bestConfidence * 0.9); // Slight penalty for solo
        outConfluence = 1;
        outReason = "solo_" + bestStrategy;
        
        PrintFormat("[CONSENSUS-SOLO-SELECT] %s | Selected %s signal=%s score=%.3f conf=%.2f | pipeline=%s",
                    symbol, bestStrategy, EnumToString(bestSignal), bestScore, outConfidence,
                    (m_pipeline != NULL ? "yes" : "no"));
        
        ulong elapsed = GetMicrosecondCount() - startTime;
        CJsonLogger::LogPerformance("EnterpriseStrategyManager", "TryFallbackSoloSignalInternal_us", (double)elapsed, CCorrelationIdGenerator::Generate());
        
        return bestSignal;
    }
    
    outReason = "no_solo_candidates";
    
    ulong elapsed = GetMicrosecondCount() - startTime;
    CJsonLogger::LogPerformance("EnterpriseStrategyManager", "TryFallbackSoloSignalInternal_us", (double)elapsed, CCorrelationIdGenerator::Generate());
    
    return TRADE_SIGNAL_NONE;
}

//+------------------------------------------------------------------+
//| Post-Consensus Signal Validation (merged from SignalValidator)  |
//+------------------------------------------------------------------+
CEnterpriseStrategyManager::SValidationResult CEnterpriseStrategyManager::ValidateSignal(const string symbol,
                                                                                        ENUM_TRADE_SIGNAL signal,
                                                                                        double confidence,
                                                                                        int confluence,
                                                                                        ENUM_SIGNAL_EVAL_MODE evalMode,
                                                                                        const SConsensusDecisionContext& ctx,
                                                                                        ulong scanCycleId,
                                                                                        const string corrId)
{
    SValidationResult result;
    result.tradeConfidence = confidence;
    result.qualityScore = ctx.directionalQuality;
    
    if(signal == TRADE_SIGNAL_NONE)
    {
        result.passed = false;
        result.vetoReason = "no_signal";
        return result;
    }
    
    // 1. Hard spread cutoff
    if(!CheckHardSpreadCutoff(symbol, signal, confidence, confluence, scanCycleId, result, corrId))
        return result;
    
    // 2. Exogenous filters (spread, ATR ratio)
    bool exogenousPass = true;
    string exogenousReason = "";
    double atrValue = 0, atrLongValue = 0;
    bool atrReady = false, atrLongReady = false;
    
    if(!CheckExogenousFilters(symbol, evalMode, exogenousPass, exogenousReason,
                              atrValue, atrLongValue, atrReady, atrLongReady, result, signal, confidence))
    {
        result.passed = false;
        result.vetoReason = exogenousReason;
        return result;
    }
    
    // 3. Quality gate - Adaptive based on consensus decision class
    double qualityThreshold = GetAdaptiveQualityThreshold(ctx, evalMode);
    
    if(ctx.directionalQuality < qualityThreshold)
    {
        result.passed = false;
        result.vetoReason = "insufficient_quality";
        result.qualityScore = ctx.directionalQuality;
        
        // Log rejection with correlation ID
        if(corrId != "")
        {
            CJsonLogger::LogSignal(symbol, signal, confidence, "VALIDATOR", corrId,
                "{\"event\":\"quality_gate_rejected\",\"class\":\"" + CEnterpriseStrategyManager::ConsensusDecisionClassToString((ENUM_CONSENSUS_DECISION_CLASS)ctx.decisionClass) + "\",\"quality\":" + DoubleToString(ctx.directionalQuality, 3) + "\",\"threshold\":" + DoubleToString(qualityThreshold, 3) + "}");
        }
        PrintFormat("[POST-CONSENSUS-FILTER] %s | filter=quality_gate | class=%s | signal=%s conf=%.2f | quality=%.3f threshold=%.3f",
                    symbol, CEnterpriseStrategyManager::ConsensusDecisionClassToString((ENUM_CONSENSUS_DECISION_CLASS)ctx.decisionClass), 
                    EnumToString(signal), confidence, ctx.directionalQuality, qualityThreshold);
        return result;
    }
    
    // 4. OFI directional confirmation
    if(m_enableOFIProxy && !CheckOFIConfirmation(symbol, signal, confidence, scanCycleId))
    {
        result.passed = false;
        result.vetoReason = "ofi_contradiction";
        return result;
    }
    
    // 5. VPIN toxicity filter
    if(m_enableVPINFilter && !CheckVPINFilter(symbol, signal, confidence, scanCycleId))
    {
        result.passed = false;
        result.vetoReason = "vpin_toxicity";
        return result;
    }
    
    // 6. Spike hunter cooldown
    if(m_spikeHunterEnabled)
    {
        // Note: spike monitor would need to be accessible - for now skip
    }
    
    // 7. Full-margin circuit breaker - handled at higher level
    
    // 8. Safe mode kill zone - handled at higher level
    
    // All checks passed
    result.passed = true;
    result.vetoReason = "";
    return result;
}

//+------------------------------------------------------------------+
//| Check Hard Spread Cutoff                                         |
//+------------------------------------------------------------------+
bool CEnterpriseStrategyManager::CheckHardSpreadCutoff(const string symbol,
                                                        ENUM_TRADE_SIGNAL signal,
                                                        double confidence,
                                                        int confluence,
                                                        ulong scanCycleId,
                                                        SValidationResult &result,
                                                        const string corrId)
{
    double bid = SymbolInfoDouble(symbol, SYMBOL_BID);
    double ask = SymbolInfoDouble(symbol, SYMBOL_ASK);
    double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
    
    if(point <= 0.0) point = 0.00001;
    double spread = (ask > 0.0 && bid > 0.0 && ask >= bid) ? (ask - bid) : 0.0;
    double spreadPts = spread / point;
    
    if(spreadPts > m_hardSpreadCutoffPoints)
    {
        result.passed = false;
        result.vetoReason = "hard_spread_cutoff";
        result.spreadScore = spreadPts;
    
        // Structured JSON logging with correlation ID
        if(CJsonLogger::IsEnabled())
        {
            string jsonData = "{\"filter\":\"hard_spread_cutoff\",\"signal\":\"" + EnumToString(signal) + "\",\"confidence\":" + DoubleToString(confidence, 2) + "\",\"spread_pts\":" + DoubleToString(spreadPts, 1) + "\",\"threshold\":" + DoubleToString(m_hardSpreadCutoffPoints, 1) + "\",\"confluence\":" + IntegerToString(confluence) + "}";
            CJsonLogger::LogWarning("SIGNAL-VALIDATOR", "Signal rejected: hard spread cutoff", "SIGNAL_REJECTED", symbol, corrId, jsonData);
        }
    
        PrintFormat("[POST-CONSENSUS-FILTER] %s | filter=hard_spread_cutoff | signal=%s conf=%.2f | spread_pts=%.1f threshold=%.1f",
                    symbol, EnumToString(signal), confidence, spreadPts, m_hardSpreadCutoffPoints);
        PrintFormat("[SIGNAL-REJECTED] cycle=%I64u | %s | reason=hard_spread_cutoff | spread_points=%.1f > %.1f | confluence=%d | conf=%.2f",
                    scanCycleId, symbol, spreadPts, m_hardSpreadCutoffPoints, confluence, confidence);
        return false;
    }
    
    result.spreadScore = spreadPts;
    return true;
}

//+------------------------------------------------------------------+
//| Check Exogenous Filters                                          |
//+------------------------------------------------------------------+
bool CEnterpriseStrategyManager::CheckExogenousFilters(const string symbol,
                                                        ENUM_SIGNAL_EVAL_MODE evalMode,
                                                        bool &exogenousPass,
                                                        string &exogenousReason,
                                                        double &atrValue,
                                                        double &atrLongValue,
                                                        bool &atrReady,
                                                        bool &atrLongReady,
                                                        SValidationResult &result,
                                                        ENUM_TRADE_SIGNAL signal,
                                                        double confidence)
{
    exogenousPass = true;
    exogenousReason = "";
    
    // Always use direct ATR calculation
    atrValue = GetATRDirect(symbol, 14, atrReady);
    atrLongValue = GetATRDirect(symbol, 50, atrLongReady);
    
    if(!atrReady || !atrLongReady || atrLongValue <= 1e-9)
    {
        // ATR not ready - allow but with caution
        result.atrReady = false;
        return true;
    }
    
    result.atrReady = true;
    result.atrValue = atrValue;
    result.atrLongValue = atrLongValue;
    result.atrRatio = atrValue / atrLongValue;
    result.atrRatio = MathMin(result.atrRatio, 10.0); // Cap
    
    // ATR Crisis gate
    double atrCrisisThreshold = GetATRCrisisThreshold(symbol);
    if(result.atrRatio > atrCrisisThreshold)
    {
        exogenousPass = false;
        exogenousReason = StringFormat("ATR ratio crisis gate: %.3f > %.3f (ATR14 %.5f / ATR50 %.5f)",
                                        result.atrRatio, atrCrisisThreshold, atrValue, atrLongValue);
        PrintFormat("[POST-CONSENSUS-FILTER] %s | filter=atr_ratio | signal=%s conf=%.2f | %s",
                    symbol, EnumToString(signal), confidence, exogenousReason);
        return true; // Return true to let caller handle veto
    }
    else if(result.atrRatio > 1.5)
    {
        result.atrRiskScale = 0.5;
        PrintFormat("[RISK-VOL-GATE] %s | atr_ratio=%.3f | action=halve_risk", symbol, result.atrRatio);
    }
    
    // Spread filter
    if(atrValue > 0)
    {
        double spreadScore = 0;
        bool isSynthetic = IsSyntheticSymbolForValidation(symbol);
        double effectiveSpreadATRRatio = isSynthetic ? m_syntheticSpreadATRRatio : m_baseSpreadATRRatio;
        
        if(m_pipeline != NULL)
        {
            if(!m_pipeline.ApplySpreadFilter(symbol, atrValue, spreadScore, effectiveSpreadATRRatio))
            {
                exogenousPass = false;
                exogenousReason = StringFormat("Spread too wide: ratio=%.4f >= %.4f (ATR %.5f)",
                                                spreadScore, effectiveSpreadATRRatio, atrValue);
            }
        }
        else
        {
            // Fallback
            double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
            if(point <= 0.0) point = 0.00001;
            double bid = SymbolInfoDouble(symbol, SYMBOL_BID);
            double ask = SymbolInfoDouble(symbol, SYMBOL_ASK);
            double spread = (ask > 0.0 && bid > 0.0 && ask >= bid) ? (ask - bid) : 0.0;
            double maxSpread = atrValue * MathMax(0.01, effectiveSpreadATRRatio);
            if(spread > maxSpread)
            {
                exogenousPass = false;
                exogenousReason = StringFormat("Spread too wide: %.5f > %.5f (ATR %.5f)", spread, maxSpread, atrValue);
            }
        }
        
        result.spreadScore = spreadScore;
    }
    
    return exogenousPass;
}

//+------------------------------------------------------------------+
//| Check OFI Confirmation                                           |
//+------------------------------------------------------------------+
bool CEnterpriseStrategyManager::CheckOFIConfirmation(const string symbol,
                                                        ENUM_TRADE_SIGNAL signal,
                                                        double confidence,
                                                        ulong scanCycleId)
{
    // Note: OFI engine access would need m_ofiEngine or m_mathRegistry
    // For now, check via m_ofiEngine if available
    if(m_ofiEngine == NULL) return true;
    
    // Explicit OFI state handling:
    // 1. OFI not available -> allow
    if(!m_ofiEngine.IsWarmedUp())
    {
        return true;
    }
    
    // 2. OFI ready - get signal
    ENUM_TRADE_SIGNAL ofiSignal = m_ofiEngine.GetSignal();
    
    // 3. OFI neutral (NONE) -> allow
    if(ofiSignal == TRADE_SIGNAL_NONE)
    {
        return true;
    }
    
    // 4. OFI directional but contradicts consensus -> veto
    if(ofiSignal != signal)
    {
        double ofiValue = m_ofiEngine.GetOFI();
        PrintFormat("[POST-CONSENSUS-FILTER] %s | filter=ofi_contradiction | signal=%s conf=%.2f | ofi=%s ofi_z=%.2f",
                    symbol, EnumToString(signal), confidence, EnumToString(ofiSignal), ofiValue);
        PrintFormat("[SIGNAL-REJECTED] cycle=%I64u | %s | reason=ofi_contradiction | consensus=%s ofi=%s ofi_z=%.2f | conf=%.2f",
                    scanCycleId, symbol, EnumToString(signal), EnumToString(ofiSignal), ofiValue, confidence);
        return false;
    }
    
    // OFI agrees with consensus or is same direction
    return true;
}

//+------------------------------------------------------------------+
//| Check VPIN Filter                                                |
//+------------------------------------------------------------------+
bool CEnterpriseStrategyManager::CheckVPINFilter(const string symbol,
                                                   ENUM_TRADE_SIGNAL signal,
                                                   double confidence,
                                                   ulong scanCycleId)
{
    // Note: VPIN filter access would need m_vpinFilter or m_mathRegistry
    if(m_vpinFilter == NULL || !m_vpinFilter.IsWarmedUp()) return true;
    
    double vpinValue = m_vpinFilter.GetVPIN();
    double mult = m_vpinFilter.GetPositionSizeMultiplier();
    
    // FIX: Instead of hard block on EXTREME VPIN, use multiplier to reduce size
    // VPIN > 0.95 = EXTREME toxicity - reduce to minimum size but don't block entirely
    if(vpinValue > 0.95) // EXTREME threshold
    {
        PrintFormat("[POST-CONSENSUS-FILTER] %s | filter=vpin_extreme | signal=%s conf=%.2f | VPIN=%.3f | mult=%.3f (reduced size)",
                    symbol, EnumToString(signal), confidence, vpinValue, mult);
        // Allow trade through with reduced size multiplier
        // Store the multiplier for position sizing to pick up
        m_lastVPINMultiplier = MathMax(mult, 0.1); // Floor at 10% minimum
        return true;
    }
    
    // HIGH toxicity: apply multiplier but don't block
    if(vpinValue > 0.85)
    {
        m_lastVPINMultiplier = mult;
        return true;
    }
    
    m_lastVPINMultiplier = 1.0;
    return true;
}

//+------------------------------------------------------------------+
//| Get ATR Direct                                                   |
//+------------------------------------------------------------------+
double CEnterpriseStrategyManager::GetATRDirect(const string symbol, int period, bool &ready)
{
    ready = false;
    CIndicatorManager* indManager = CIndicatorManager::Instance();
    if(indManager == NULL) return 0;
    
    ENUM_TIMEFRAMES tf = Period();
    if(tf == PERIOD_CURRENT || tf == 0) tf = PERIOD_M15;
    
    int handle = indManager.GetATRHandle(symbol, tf, period);
    if(handle == INVALID_HANDLE) return 0;
    
    double buffer[];
    ArraySetAsSeries(buffer, true);
    if(CopyBuffer(handle, 0, 0, 1, buffer) > 0)
    {
        double atrValue = buffer[0];
        if(atrValue > 0.0 && MathIsValidNumber(atrValue))
        {
            ready = true;
            return atrValue;
        }
    }
    return 0;
}

//+------------------------------------------------------------------+
//| Get ATR Crisis Threshold                                         |
//+------------------------------------------------------------------+
double CEnterpriseStrategyManager::GetATRCrisisThreshold(const string symbol)
{
    // From EA inputs
    if(IsSyntheticSymbolForValidation(symbol))
    {
        // Would use specific synthetic thresholds
        return 2.5; // Default
    }
    return 2.0; // Default for forex
}

//+------------------------------------------------------------------+
//| Is Synthetic Symbol for Validation                               |
//+------------------------------------------------------------------+
bool CEnterpriseStrategyManager::IsSyntheticSymbolForValidation(const string symbol)
{
    // Use global multi-asset profiler for proper asset classification
    if(m_multiAssetProfiler != NULL)
    {
        SAssetProfile profile = m_multiAssetProfiler.GetProfile(symbol);
        return IsSyntheticAssetClass(profile.assetClass);
    }

    // Fallback to string matching if profiler not available
    return (StringFind(symbol, "Volatility") >= 0 || StringFind(symbol, "Crash") >= 0 ||
            StringFind(symbol, "Boom") >= 0 || StringFind(symbol, "Jump") >= 0 ||
            StringFind(symbol, "Step") >= 0 || StringFind(symbol, "DEX") >= 0 ||
            StringFind(symbol, "Range") >= 0 || StringFind(symbol, "Gain") >= 0 ||
            StringFind(symbol, "Pain") >= 0 || StringFind(symbol, "Flip") >= 0);
}

//+------------------------------------------------------------------+
//| Get Adaptive Quality Threshold                                   |
//+------------------------------------------------------------------+
double CEnterpriseStrategyManager::GetAdaptiveQualityThreshold(const SConsensusDecisionContext& ctx,
                                                                ENUM_SIGNAL_EVAL_MODE evalMode)
{
    // Base thresholds from validator config
    double baseThreshold = (evalMode == EVAL_MODE_INTRABAR)
        ? m_validatorIntrabarMinQuality
        : m_validatorNewBarMinQuality;
    
    // Adapt based on consensus decision class
    ENUM_CONSENSUS_DECISION_CLASS decisionClass = (ENUM_CONSENSUS_DECISION_CLASS)ctx.decisionClass;
    
    switch(decisionClass)
    {
        case CONSENSUS_DECISION_FULL_QUORUM:
            // Full quorum: use consensus threshold (lower, around 0.40-0.55)
            // but don't go below 0.40
            return MathMax(0.40, ctx.directionalQuality * 0.9);
        
        case CONSENSUS_DECISION_SPARSE_INTRABAR:
            // Sparse intrabar: use sparse threshold (lower, around 0.50-0.60)
            return MathMax(0.45, ctx.directionalQuality * 0.85);
        
        case CONSENSUS_DECISION_MARGINAL_ADMIT:
            // Marginal admit: use marginal threshold (around 0.65)
            return 0.65;
        
        case CONSENSUS_DECISION_SOLO_FALLBACK:
            // Solo fallback: use solo threshold (0.65-0.70)
            return (evalMode == EVAL_MODE_INTRABAR) ? 0.70 : 0.65;
        
        default:
            // Default: use validator config thresholds
            return baseThreshold;
    }
}

//+------------------------------------------------------------------+
//| Get Validation Status Report                                     |
//+------------------------------------------------------------------+
string CEnterpriseStrategyManager::GetValidationStatusReport() const
{
    string report = "[EnterpriseStrategyManager::Validation] Config:\n";
    report += "  IntrabarMinQuality=" + DoubleToString(m_validatorIntrabarMinQuality, 2);
    report += " | NewBarMinQuality=" + DoubleToString(m_validatorNewBarMinQuality, 2) + "\n";
    report += "  HardSpreadCutoff=" + DoubleToString(m_hardSpreadCutoffPoints, 1) + " pts\n";
    report += "  OFIProxy=" + (m_enableOFIProxy ? "ON" : "OFF");
    report += " | VPINFilter=" + (m_enableVPINFilter ? "ON" : "OFF");
    report += " | SpikeHunter=" + (m_spikeHunterEnabled ? "ON" : "OFF") + "\n";
    report += "  LastVPINMultiplier=" + DoubleToString(m_lastVPINMultiplier, 3) + "\n";
    return report;
}

//+------------------------------------------------------------------+
//| Set Validator Config                                             |
//+------------------------------------------------------------------+
void CEnterpriseStrategyManager::SetValidatorConfig(double intrabarMinQuality,
                                                    double newBarMinQuality,
                                                    double hardSpreadCutoff,
                                                    bool spikeHunterEnabled,
                                                    bool enableOFI,
                                                    bool enableVPIN,
                                                    double baseSpreadATRRatio,
                                                    double syntheticSpreadATRRatio)
{
    m_validatorIntrabarMinQuality = MathMax(0.0, MathMin(1.0, intrabarMinQuality));
    m_validatorNewBarMinQuality = MathMax(0.0, MathMin(1.0, newBarMinQuality));
    m_hardSpreadCutoffPoints = hardSpreadCutoff;
    m_spikeHunterEnabled = spikeHunterEnabled;
    m_enableOFIProxy = enableOFI;
    m_enableVPINFilter = enableVPIN;
    m_baseSpreadATRRatio = baseSpreadATRRatio;
    m_syntheticSpreadATRRatio = syntheticSpreadATRRatio;
}

#endif // ENTERPRISE_STRATEGY_MANAGER_MQH
