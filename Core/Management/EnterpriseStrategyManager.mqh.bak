//+------------------------------------------------------------------+
//| Get Ensemble Confidence                                          |
//+------------------------------------------------------------------+
double CEnterpriseStrategyManager::GetEnsembleConfidence() const
{
    double weightedSum = 0.0;
    double totalWeight = 0.0;
    for(int i = 0; i < m_strategyCount; i++)
    {
        if(!m_strategies[i].enabled || m_strategies[i].strategy == NULL)
            continue;
        double weight = MathMax(0.0, m_strategies[i].weight);
        double conf = MathMax(0.0, m_strategies[i].avgConfidence);
        if(weight <= 0.0)
            continue;
        weightedSum += (conf * weight);
        totalWeight += weight;
    }
    if(totalWeight <= 0.0)
        return 0.0;
    return MathMax(0.0, MathMin(1.0, weightedSum / totalWeight));
}

